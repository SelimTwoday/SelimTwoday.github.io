---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
	title="PERT-kalkylator"
	description="Räkna ut ett PERT-tidsestimat för en grupp utifrån optimistiska, sannolika och pessimistiska gissningar."
	showBackLink
>
	<div class="container page">
		<header class="page__header">
			<h1>PERT-kalkylator</h1>
			<p class="page__lead">
				Estimera tillsammans som tidigare, eller byt till PERT Pro för att räkna ihop 
				namngivna deluppgifter och få ett statistiskt konfidensintervall.
			</p>
		</header>

		<fieldset class="mode-switch" aria-label="Typ av PERT-estimat">
			<label class="mode-switch__option">
				<input type="radio" name="pert-mode" value="participants" checked />
				<span>
					<strong>Gruppestimat</strong>
					<small>Sammanväg deltagarnas bedömningar</small>
				</span>
			</label>
			<label class="mode-switch__option">
				<input type="radio" name="pert-mode" value="tasks" />
				<span>
					<strong>PERT Pro</strong>
					<small>Summera deluppgifter och osäkerhet</small>
				</span>
			</label>
		</fieldset>

		<div class="pert-workspace">
			<div class="pert-workspace__form">
				<form id="participant-form" class="pert-form" novalidate>
					<div class="participants card">
						<div class="participants__header">
							<div class="participants__heading">
								<h2>Deltagare</h2>
								<span id="participant-count" class="participants__count" aria-live="polite"
									>1 person</span
								>
							</div>
							<button
								type="button"
								id="add-row-button"
								class="participants__add"
								aria-label="Lägg till deltagare"
								title="Lägg till deltagare"
							>
								<span aria-hidden="true" >+</span>
							</button>
						</div>
						<div class="participant-grid">
							<div class="participant-columns" aria-hidden="true">
								<span>Optimistisk</span>
								<span>Mest trolig</span>
								<span>Pessimistisk</span>
								<span></span>
							</div>
							<ul id="participant-rows" class="participant-rows"></ul>
						</div>
					</div>

					<p class="pert-estimate-reminder">
						Tänk på att inkludera tiden för själva arbetsinsatsen, genomgång av risker,
						eventuell databashämtning, skapande av tester och PR-granskning. 
						Väg även in behov av spetskompetens och domänkunskap,
						beroenden, tekniska frågetecken, integration och dokumentation.
					</p>

					<div id="pert-warnings" class="result-warnings" aria-live="polite">
						<p
							id="uncertainty-warning"
							class="status-message result-warning"
							data-tone="warning"
							hidden
						></p>
						<p
							id="disagreement-warning"
							class="status-message result-warning"
							data-tone="warning"
							hidden
						></p>
					</div>

					<div class="settings card">
						<h2 class="settings__title">Inställningar</h2>
						<div class="settings__grid">
							<label class="field">
								<span>Mötestid per person (timmar)</span>
								<input
									type="text"
									id="meeting-hours-input"
									inputmode="decimal"
									autocomplete="off"
									value="1"
									aria-describedby="meeting-hours-error"
								/>
								<p id="meeting-hours-error" class="field__error" aria-live="polite"></p>
							</label>
						</div>
					</div>

				</form>

				<form id="task-form" class="pert-form" novalidate hidden>
					<div class="participants">
						<div class="participants__header">
							<div>
								<h2>Deluppgifter</h2>
								<p class="participants__description">
									Varje rad beräknas separat. Variansen summeras innan standardavvikelsen tas fram.
								</p>
							</div>
						</div>
						<ul id="task-rows" class="participant-rows"></ul>
						<button type="button" id="add-task-button" class="button button-secondary task-rows__add">
							+ Lägg till deluppgift
						</button>
					</div>
				</form>

				<div id="pert-errors" class="status-message" data-tone="error" role="alert" hidden></div>

				<template id="row-template">
					<li class="participant-row">
						<label class="field participant-row__field">
							<span class="visually-hidden">Optimistisk</span>
							<span class="input-control">
								<span class="input-control__prefix" aria-hidden="true">O</span>
								<input
									type="text"
									class="field-o input-control__input"
									inputmode="decimal"
									autocomplete="off"
								/>
							</span>
						</label>
						<label class="field participant-row__field">
							<span class="visually-hidden">Mest trolig</span>
							<span class="input-control">
								<span class="input-control__prefix" aria-hidden="true">M</span>
								<input
									type="text"
									class="field-m input-control__input"
									inputmode="decimal"
									autocomplete="off"
								/>
							</span>
						</label>
						<label class="field participant-row__field">
							<span class="visually-hidden">Pessimistisk</span>
							<span class="input-control">
								<span class="input-control__prefix" aria-hidden="true">P</span>
								<input
									type="text"
									class="field-p input-control__input"
									inputmode="decimal"
									autocomplete="off"
								/>
							</span>
						</label>
						<button type="button" class="participant-row__remove" aria-label="Ta bort deltagare">
							✕
						</button>
						<p class="participant-row__error field__error" aria-live="polite"></p>
					</li>
				</template>

				<template id="task-row-template">
					<li class="participant-row task-row card">
						<label class="field task-row__title-field">
							<span class="visually-hidden">Titel</span>
							<input
								type="text"
								class="field-title"
								autocomplete="off"
							/>
						</label>
						<div class="task-row__actions">
							<button
								type="button"
								class="participant-row__remove"
								aria-label="Ta bort deluppgift"
								title="Ta bort deluppgift"
							>
								<span aria-hidden="true">✕</span>
							</button>
						</div>
						<div class="participant-row__fields">
							<label class="field">
								<span>Optimistisk</span>
								<span class="input-control">
									<span class="input-control__prefix" aria-hidden="true">O</span>
									<input type="text" class="field-o input-control__input" inputmode="decimal" autocomplete="off" />
								</span>
							</label>
							<label class="field">
								<span>Mest trolig</span>
								<span class="input-control">
									<span class="input-control__prefix" aria-hidden="true">M</span>
									<input type="text" class="field-m input-control__input" inputmode="decimal" autocomplete="off" />
								</span>
							</label>
							<label class="field">
								<span>Pessimistisk</span>
								<span class="input-control">
									<span class="input-control__prefix" aria-hidden="true">P</span>
									<input type="text" class="field-p input-control__input" inputmode="decimal" autocomplete="off" />
								</span>
							</label>
						</div>
						<p class="participant-row__error field__error" aria-live="polite"></p>
					</li>
				</template>

				<dialog id="remove-task-dialog" class="confirmation-dialog" aria-labelledby="remove-task-title">
					<div class="confirmation-dialog__content">
						<h2 id="remove-task-title">Ta bort deluppgift?</h2>
						<p id="remove-task-copy">
							Är du säker? Inmatade O-, M- och P-värden försvinner.
						</p>
						<div class="confirmation-dialog__actions">
							<button type="button" id="cancel-remove-task" class="button button-secondary">
								Avbryt
							</button>
							<button type="button" id="confirm-remove-task" class="button button-danger">
								Ta bort
							</button>
						</div>
					</div>
				</dialog>

			</div>

			<div class="pert-workspace__result">
				<div id="pert-result-empty" class="card result-empty">
					<p id="result-empty-copy">Fyll i minst en deltagare med giltiga O-, M- och P-värden så visas resultatet här.</p>
				</div>

				<section id="pert-result-panel" class="card result-panel" hidden aria-labelledby="result-heading">
					<h2 id="result-heading">Resultat</h2>
					<div id="participant-result">
						<p class="result-panel__subtitle">Baserat på medelvärdet av alla inmatade O-, M- och P-värden.</p>

						<div class="result-averages">
							<div class="result-box">
								<div class="result-box__label">Optimistisk</div>
								<div class="result-box__value" id="avg-o">–</div>
							</div>
							<div class="result-box">
								<div class="result-box__label">Mest sannolik</div>
								<div class="result-box__value" id="avg-m">–</div>
							</div>
							<div class="result-box">
								<div class="result-box__label">Pessimistisk</div>
								<div class="result-box__value" id="avg-p">–</div>
							</div>
						</div>

						<p class="result-formula" id="pert-formula">PERT = (O + 4×M + P) / 6</p>

						<div class="result-final">
							<div class="result-final__item">
								<div class="result-final__label">PERT (utan möten)</div>
								<div class="result-final__value" id="pert-hours">–</div>
								<div class="result-final__sub" id="pert-days"></div>
							</div>
							<div class="result-final__item">
								<div class="result-final__label">Tid lagd på estimering</div>
								<div class="result-final__value" id="meeting-hours">–</div>
								<div class="result-final__sub" id="meeting-note"></div>
							</div>
							<div class="result-final__item result-final__item--highlight">
								<div class="result-final__label">Slutgiltigt resultat</div>
								<div class="result-final__value" id="final-hours">–</div>
								<div class="result-final__sub" id="final-days"></div>
								<div class="result-final__sub" id="pert-confidence"></div>
							</div>
						</div>

						<p class="result-note" id="people-note"></p>
					</div>

					<div id="task-result" hidden>
						<p class="result-panel__subtitle">
							Deluppgifternas förväntade tider summeras. Oberoende osäkerheter kombineras genom att summera varianserna.
						</p>

						<div class="result-averages">
							<div class="result-box">
								<div class="result-box__label">Optimistisk summa</div>
								<div class="result-box__value" id="task-total-o">–</div>
							</div>
							<div class="result-box">
								<div class="result-box__label">Mest sannolik summa</div>
								<div class="result-box__value" id="task-total-m">–</div>
							</div>
							<div class="result-box">
								<div class="result-box__label">Pessimistisk summa</div>
								<div class="result-box__value" id="task-total-p">–</div>
							</div>
						</div>

						<div class="result-final">
							<div class="result-final__item result-final__item--highlight">
								<div class="result-final__label">Förväntad total tid</div>
								<div class="result-final__value" id="task-expected-hours">–</div>
								<div class="result-final__sub" id="task-expected-days"></div>
							</div>
							<div class="result-final__item result-final__item--wide">
								<div class="result-final__label">Kombinerad standardavvikelse</div>
								<div class="result-final__value" id="task-standard-deviation">–</div>
								<div class="result-final__sub">σ = √Σ((P − O) / 6)²</div>
							</div>
						</div>

						<h3 class="result-section-heading">Konfidensintervall</h3>
						<div class="confidence-list" id="confidence-list"></div>

						<h3 class="result-section-heading">Deluppgifter</h3>
						<div class="task-breakdown" id="task-breakdown"></div>
						<p class="result-note" id="task-note"></p>
					</div>
				</section>
				
				<div class="pert-actions">
					<button type="button" id="share-button" class="button button-secondary" disabled>
						Kopiera länk
					</button>
					<button type="button" id="png-button" class="button button-secondary" disabled>
						Kopiera bild (PNG)
					</button>
					<button type="button" id="combined-button" class="button button-primary" disabled>
						Kopiera bild + länk
					</button>
				</div>
				<p id="share-status" class="action-status" role="status" aria-live="polite"></p>
				<p id="png-status" class="action-status" role="status" aria-live="polite"></p>
				<p id="combined-status" class="action-status" role="status" aria-live="polite"></p>
			</div>
		</div>
	</div>
</BaseLayout>

<script src="../../../scripts/pert-client.ts"></script>

<style>
	.page {
		padding-block: 2.5rem 4rem;
	}

	.page__header {
		margin-bottom: 2rem;
	}

	.page__header h1 {
		font-size: clamp(1.9rem, 4vw, 2.6rem);
		margin: 0 0 0.6rem;
	}

	.page__lead {
		color: var(--color-text-muted);
		font-size: 1.02rem;
		margin: 0;
		max-width: 40rem;
	}

	.mode-switch {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.5rem;
		width: min(100%, 38rem);
		padding: 0.35rem;
		margin-bottom: 2rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-bg-elevated);
	}

	.mode-switch__option {
		position: relative;
		cursor: pointer;
	}

	.mode-switch__option input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.mode-switch__option > span {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		height: 100%;
		padding: 0.75rem 1rem;
		border: 1px solid transparent;
		border-radius: calc(var(--radius-lg) - 4px);
		color: var(--color-text-muted);
		transition: color 150ms ease, border-color 150ms ease, background-color 150ms ease;
	}

	.mode-switch__option small {
		font-size: 0.78rem;
		line-height: 1.35;
	}

	.mode-switch__option input:checked + span {
		color: var(--color-text);
		border-color: var(--color-primary);
		background: var(--color-primary-muted);
	}

	.mode-switch__option input:focus-visible + span {
		box-shadow: var(--focus-ring);
	}

	.pert-workspace {
		display: grid;
		grid-template-columns: minmax(0, .5fr) minmax(22rem, .85fr);
		align-items: start;
		gap: 2rem;
	}

	.pert-workspace__form {
		min-width: 0;
	}

	.pert-workspace__result {
		position: sticky;
		top: 1.5rem;
	}

	@media (max-width: 900px) {
		.pert-workspace {
			grid-template-columns: 1fr;
		}

		.pert-workspace__result {
			position: static;
		}
	}

	.settings {
		padding: 1rem 1.25rem 1.25rem;
	}

	.settings__title {
		font-weight: 800;
		font-size: 1.05rem;
		margin: 0 0 0.4rem;
	}

	.settings__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
		gap: 0.6rem;
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--color-text-muted);
	}

	.field > input {
		font: inherit;
		font-size: 0.95rem;
		font-weight: 500;
		color: var(--color-text);
		background: var(--color-bg);
		border: 1px solid var(--color-border-strong);
		border-radius: 8px;
		padding: 0.45rem 0.6rem;
		min-height: 2.2rem;
	}

	.field > input[aria-invalid='true'] {
		border-color: var(--color-danger-border);
	}

	.input-control {
		display: flex;
		align-items: stretch;
		border: 1px solid var(--color-border-strong);
		border-radius: 8px;
		background: var(--color-bg);
		transition: border-color 150ms ease;
	}

	.input-control:focus-within {
		border-color: var(--color-primary);
	}

	.input-control:has(.input-control__input[aria-invalid='true']) {
		border-color: var(--color-danger-border);
	}

	.input-control__prefix {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 1.5rem;
		padding-inline: 0.35rem;
		font-weight: 800;
		font-size: 0.8rem;
		color: var(--color-text-muted);
		background: var(--color-bg-elevated-2);
		border-right: 1px solid var(--color-border-strong);
		border-top-left-radius: 8px;
		border-bottom-left-radius: 8px;
	}

	.input-control__input {
		flex: 1;
		min-width: 0;
		width: 100%;
		font: inherit;
		font-size: 0.95rem;
		font-weight: 500;
		color: var(--color-text);
		background: transparent;
		border: none;
		padding: 0.4rem 0.4rem;
		min-height: 2.2rem;
	}

	.input-control__input:focus {
		outline: none;
	}

	.field__error {
		margin: 0;
		min-height: 1.1em;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--color-danger);
	}

	.field__error:empty {
		display: none;
	}

	.participants {
		padding: 1rem 1.25rem 1.25rem;
		margin-bottom: 1.25rem;
	}

	.pert-estimate-reminder {
		padding-inline: 1.25rem;
		margin: 0 0 1.25rem;
		color: var(--color-text-muted);
		font-size: 0.9rem;
		line-height: 1.5;
	}

	.participants__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-bottom: 0.9rem;
	}

	.participants__heading {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.participants__heading h2 {
		font-size: 1.2rem;
		margin: 0;
	}

	.participants__count {
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--color-text-muted);
	}

	.participants__add {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.5rem;
		height: 1.5rem;
		flex-shrink: 0;
		font-size: 1.2rem;
		font-weight: 500;
		line-height: 1;
		color: var(--color-text-muted);
		background: var(--color-bg-elevated-2);
		border: none;
		border-radius: 999px;
		cursor: pointer;
		transition: filter 150ms ease, transform 150ms ease;
	}

	.participants__add:hover {
		filter: brightness(1.08);
	}

	.participants__add:active {
		transform: scale(0.94);
	}

	.participants__add span {
		height: 22px;
	}

	.participant-grid {
		/* Safety net only — the grid below is fully fluid and shouldn't need to scroll. */
		overflow-x: auto;
	}

	.participant-columns,
	.participant-row {
		display: grid;
		grid-template-columns: repeat(3, minmax(3rem, 1fr)) 1.6rem;
		align-items: center;
		gap: 0.4rem;
	}

	.participant-columns {
		padding-bottom: 0.4rem;
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--color-text-muted);
	}

	.participant-columns span {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.participants__description {
		margin: 0.3rem 0 0;
		max-width: 34rem;
		color: var(--color-text-muted);
		font-size: 0.88rem;
		line-height: 1.45;
	}

	.participant-rows {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
	}

	.participant-row {
		padding: 0.6rem 0;
		border-top: 1px solid var(--color-border);
	}

	.participant-rows > .participant-row:first-child {
		border-top: none;
		padding-top: 0;
	}

	.participant-rows > .participant-row:last-child {
		padding-bottom: 0;
	}

	.participant-row__remove {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		justify-self: center;
		width: 1.6rem;
		height: 1.6rem;
		flex-shrink: 0;
		font-size: 0.85rem;
		line-height: 1;
		color: var(--color-text-muted);
		background: transparent;
		border: none;
		border-radius: var(--radius-md);
		cursor: pointer;
		transition: background-color 150ms ease, color 150ms ease;
	}

	.participant-row__remove:hover:not(:disabled) {
		background: var(--color-bg-elevated-2);
		color: var(--color-text);
	}

	.participant-row__remove:disabled {
		opacity: 0.35;
		cursor: not-allowed;
	}

	.participant-row__field {
		min-width: 0;
	}

	.participant-row__error {
		grid-column: 1 / -1;
	}

	.task-row__title-field {
		min-width: 0;
		margin: 0;
	}

	.task-row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 2rem;
		align-items: start;
		gap: 0.75rem;
		padding: 0.75rem;
		margin-bottom: 1rem;
		border-top: 1px solid var(--color-border);
		transition: border-color 150ms ease, opacity 150ms ease, transform 150ms ease;
	}

	.participant-rows > .task-row:first-child {
		padding-top: 0.75rem;
	}

	.participant-rows > .task-row:last-child {
		padding-bottom: 0.75rem;
