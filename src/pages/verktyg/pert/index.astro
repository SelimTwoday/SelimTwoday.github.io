---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EnterpriseGag from '../../../components/EnterpriseGag.astro';
import EstimateTable from '../../../components/pert/EstimateTable.astro';
import ResultHead from '../../../components/pert/ResultHead.astro';
import ShareBar from '../../../components/pert/ShareBar.astro';
import '../../../styles/pert.css';

const checklist = [
	'Själva arbetet',
	'Riskgenomgång',
	'Databashämtning',
	'Tester',
	'PR-granskning',
	'Spetskompetens',
	'Domänkunskap',
	'Beroenden',
	'Tekniska frågetecken',
	'Integration',
	'Dokumentation',
];
---

<BaseLayout
	title="PERT-kalkylator"
	description="Räkna ut PERT-estimat för grupper och deluppgifter, eller jämför personers projektuppskattningar med PERT Pro Enterprise."
>
	{import.meta.env.PROD && (
		<meta
			slot="head"
			http-equiv="Content-Security-Policy"
			content="default-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
		/>
	)}
	<div class="pert-page">
		<div class="container pert-shell">
			<header class="pert-header">
				<div class="pert-header__text">
					<h1>PERT-kalkylator</h1>
					<p data-lead>Varje deltagare uppskattar hela uppgiften. Värdena vägs ihop till ett gemensamt estimat.</p>
				</div>
				<nav class="pert-modes" aria-label="Läge">
					<a class="pert-modes__link" href="?mode=group" data-mode-link="participants">Gruppestimat</a>
					<a class="pert-modes__link" href="?mode=tasks" data-mode-link="tasks">PERT Pro</a>
					<a class="pert-modes__link" href="?mode=grouptasks" data-mode-link="grouptasks">Enterprise</a>
				</nav>
			</header>

			<p class="pert-url-error" data-url-error role="alert" hidden></p>

			<!-- Gruppestimat -->
			<section class="pert-workspace" data-workspace="participants" aria-label="Gruppestimat">
				<div class="pert-input">
					<div class="pert-card">
						<div class="pert-card__head">
							<h2>Deltagare</h2>
							<span class="pert-count" data-count></span>
						</div>
						<EstimateTable nameHeading="Namn" addLabel="Lägg till deltagare" footLabel="Medel" />
					</div>

					<p class="pert-note" data-row-error role="status" hidden></p>

					<div class="pert-alert" data-disagree role="status" hidden>
						<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="8" cy="8" r="6.5"></circle><path d="M8 4.5v4M8 11v.01"></path></svg>
						<p data-disagree-text></p>
					</div>

					<details class="pert-card pert-checklist" data-checklist>
						<summary>
							<svg class="pert-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 2.5L7.5 6 4 9.5"></path></svg>
							<span class="pert-checklist__title">Har ni räknat med allt?</span>
							<span class="pert-num pert-checklist__count" data-checklist-count>0 av {checklist.length}</span>
						</summary>
						<div class="pert-chips">
							{checklist.map((label) => (
								<button type="button" class="pert-chip" aria-pressed="false" data-check>
									<svg class="pert-chip__tick" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 6.2l2.3 2.3 4.7-5"></path></svg>
									{label}
								</button>
							))}
						</div>
					</details>
				</div>

				<aside class="pert-result pert-card" data-panel aria-label="Resultat">
					<ResultHead label="Gemensamt estimat" tail="likely" />
					<p class="pert-empty" data-empty>Fyll i en rad för att se ett estimat.</p>
					<div class="pert-result__body" data-result-body>
						<div class="pert-split" aria-hidden="true">
							<div class="pert-split__work" data-bar-work></div>
							<div class="pert-split__meeting" data-bar-meeting></div>
						</div>
						<div class="pert-line">
							<span class="pert-swatch pert-swatch--work"></span>
							<span>Arbete (PERT)</span>
							<span class="pert-num pert-line__end"><span data-out="pert">–</span> h</span>
						</div>
						<div class="pert-line pert-line--meeting">
							<span class="pert-swatch pert-swatch--meeting"></span>
							<label for="pert-meeting">Estimeringsmöte</label>
							<span class="pert-num pert-muted"><span data-out="people">0</span> ×</span>
							<input id="pert-meeting" class="pert-inline pert-inline--wide pert-num" data-meeting inputmode="decimal" autocomplete="off" maxlength="6" aria-describedby="pert-meeting-unit" />
							<span id="pert-meeting-unit" class="pert-muted">h/person</span>
							<span class="pert-num pert-line__end"><span data-out="meetTotal">–</span> h</span>
						</div>
						<hr class="pert-rule" />
						<div class="pert-triple">
							<div><span>Optimistisk</span><span class="pert-num"><span data-out="avgO">–</span> h</span></div>
							<div><span>Mest trolig</span><span class="pert-num"><span data-out="avgM">–</span> h</span></div>
							<div><span>Pessimistisk</span><span class="pert-num"><span data-out="avgP">–</span> h</span></div>
						</div>
						<p class="pert-flag" data-out="uncertainty" hidden>
							<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="8" cy="8" r="6.5"></circle><path d="M8 4.5v4M8 11v.01"></path></svg>
							Stort spann mellan optimistiskt och pessimistiskt.
						</p>
						<details class="pert-how" data-export-hide>
							<summary>
								<svg class="pert-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 2.5L7.5 6 4 9.5"></path></svg>
								Hur räknas det?
							</summary>
							<p class="pert-formula pert-num" data-out="formula"></p>
							<p>O, M och P är medelvärden av deltagarnas bedömningar. Mötestiden läggs ovanpå. Intervallet är ± en standardavvikelse, (P − O) / 6, och bygger på antagandet att bedömningarna är normalfördelade.</p>
						</details>
						<div class="pert-export-only" data-export-list></div>
					</div>
					<ShareBar notice="Länken innehåller namn och estimat." />
				</aside>
			</section>

			<!-- PERT Pro -->
			<section class="pert-workspace" data-workspace="tasks" aria-label="PERT Pro" hidden>
				<div class="pert-input">
					<div class="pert-card">
						<div class="pert-card__head">
							<h2>Deluppgifter</h2>
							<span class="pert-count" data-count></span>
						</div>
						<EstimateTable nameHeading="Deluppgift" addLabel="Lägg till deluppgift" />
					</div>
					<p class="pert-note" data-row-error role="status" hidden></p>
				</div>

				<aside class="pert-result pert-card" data-panel aria-label="Resultat">
					<ResultHead label="Förväntad total tid" tail="sd" />
					<p class="pert-empty" data-empty>Fyll i en rad för att se ett estimat.</p>
					<div class="pert-result__body" data-result-body>
						<div data-band></div>
						<hr class="pert-rule" />
						<div class="pert-shares">
							<div class="pert-shares__head">
								<h3>Var sitter osäkerheten?</h3>
								<span>andel av variansen</span>
							</div>
							<ul class="pert-shares__list" data-shares></ul>
						</div>
						<details class="pert-how" data-export-hide>
							<summary>
								<svg class="pert-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 2.5L7.5 6 4 9.5"></path></svg>
								Hur räknas det?
							</summary>
							<p class="pert-formula pert-num" data-out="formula"></p>
							<p>Varje deluppgift ger (O + 4M + P) / 6 och σ = (P − O) / 6. Tiderna summeras och varianserna läggs ihop innan roten dras. Det förutsätter att deluppgifterna är oberoende av varandra: hänger de ihop underskattas osäkerheten och 95 %-intervallet blir för smalt. Intervallen är riktmärken, inte garantier.</p>
						</details>
					</div>
					<ShareBar />
				</aside>
			</section>

			<!-- Enterprise -->
			<section class="pert-workspace" data-workspace="grouptasks" aria-label="Enterprise" hidden>
				<div class="pert-input">
					<div class="pert-people">
						<div class="pert-people__chips" data-chips role="group" aria-label="Personer"></div>
						<button type="button" class="pert-ghost" data-add-person>
							<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M7 2v10M2 7h10"></path></svg>
							Lägg till person
						</button>
						<span class="pert-people__spacer"></span>
						<button type="button" class="pert-ghost" data-import-toggle aria-expanded="false" aria-controls="pert-import-panel">
							<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 2v7M4 6.5L7 9.5l3-3M2.5 12h9"></path></svg>
							Importera estimat
						</button>
					</div>

					<div class="pert-import" id="pert-import-panel" data-import-panel hidden>
						<label for="pert-import-url">Klistra in en PERT Pro- eller Enterprise-länk</label>
						<div class="pert-import__row">
							<input id="pert-import-url" class="pert-field" data-import-url type="text" inputmode="url" autocomplete="off" spellcheck="false" placeholder="https://…" aria-describedby="pert-import-error" />
							<button type="button" class="pert-primary pert-primary--small" data-import-run>Importera</button>
							<button type="button" class="pert-ghost" data-import-cancel>Avbryt</button>
						</div>
						<p class="pert-import__error" id="pert-import-error" data-import-error role="alert"></p>
					</div>

					<div class="pert-status" data-import-status role="status" hidden>
						<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 7.3l2.8 2.8 6-6.4"></path></svg>
						<span data-import-text></span>
						<span class="pert-people__spacer"></span>
						<button type="button" class="pert-ghost" data-import-undo>Ångra</button>
						<button type="button" class="pert-ghost pert-ghost--icon" data-import-dismiss aria-label="Stäng meddelande">
							<svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M2 2l8 8M10 2l-8 8"></path></svg>
						</button>
					</div>

					<div class="pert-card">
						<div class="pert-card__head pert-card__head--person">
							<label class="pert-visually-hidden" for="pert-person-name">Namn på person</label>
							<input id="pert-person-name" class="pert-cell pert-cell--name pert-person-name" data-person-name maxlength="200" placeholder="Namn" autocomplete="off" />
							<span class="pert-people__spacer"></span>
							<button type="button" class="pert-ghost" data-remove-person>Ta bort person</button>
						</div>
						<EstimateTable nameHeading="Deluppgift" addLabel="Lägg till deluppgift" />
					</div>

					<p class="pert-note" data-row-error role="status" hidden></p>
					<div class="pert-gaps" data-gaps></div>
				</div>

				<aside class="pert-result pert-card" data-panel aria-label="Resultat">
					<ResultHead label="Förväntad projekttid" tail="sd" />
					<p class="pert-empty" data-empty>Fyll i en rad för att se ett estimat.</p>
					<div class="pert-result__body" data-result-body>
						<div data-band></div>
						<hr class="pert-rule" />
						<div class="pert-triple">
							<div><span>Optimistisk</span><span class="pert-num"><span data-out="avgO">–</span> h</span></div>
							<div><span>Mest trolig</span><span class="pert-num"><span data-out="avgM">–</span> h</span></div>
							<div><span>Pessimistisk</span><span class="pert-num"><span data-out="avgP">–</span> h</span></div>
						</div>
						<div class="pert-people-totals">
							<div class="pert-people-totals__head">
								<span>Personernas totaler</span>
								<span data-out="spread"></span>
							</div>
							<div class="pert-dots" aria-hidden="true" data-dots>
								<div class="pert-dots__line"></div>
								<div class="pert-dots__mean" data-dots-mean></div>
							</div>
							<ul class="pert-people-totals__list" data-person-list></ul>
						</div>
						<p class="pert-flag" data-out="disagreement" hidden></p>
						<p class="pert-flag" data-out="uncertainty" hidden>
							<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="8" cy="8" r="6.5"></circle><path d="M8 4.5v4M8 11v.01"></path></svg>
							Stort spann mellan optimistiskt och pessimistiskt.
						</p>
						<details class="pert-how" data-export-hide>
							<summary>
								<svg class="pert-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 2.5L7.5 6 4 9.5"></path></svg>
								Hur räknas det?
							</summary>
							<p>Varje deluppgift ger (O + 4M + P) / 6 och σ = (P − O) / 6. Personens total är summan, gruppens är medelvärdet av totalerna. Osäkerheten väger ihop variansen inom personerna (<span class="pert-num" data-out="within">–</span> h) och skillnaden mellan dem (<span class="pert-num" data-out="between">–</span> h).</p>
							<p>Modellen förutsätter att deluppgifterna är oberoende av varandra: hänger de ihop underskattas osäkerheten. Intervallen bygger på en normalapproximation och är riktmärken, inte garantier, särskilt med få personer eller stor oenighet.</p>
						</details>
					</div>
					<ShareBar notice="Länken innehåller namn och estimat." />
				</aside>
			</section>
		</div>

		<button type="button" class="pert-summary" data-summary hidden>
			<span class="pert-num" data-summary-text></span>
			<span class="pert-summary__cta">Visa resultat</span>
		</button>
	</div>
	<EnterpriseGag />
</BaseLayout>

<script src="../../../scripts/pert/main.ts"></script>
