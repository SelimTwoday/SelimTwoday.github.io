---
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container site-footer__inner">
		<p>&copy; {year} Selim Hjorthall.</p>
		<nav aria-label="Sidfotsnavigation" class="site-footer__nav">
			<a href="/">Hem</a>
			<a href="/verktyg/pert/">PERT-kalkylator</a>
			<a href="/verktyg/kodfilosofi/">Utvecklingsmetodik</a>
			<a href="https://github.com/SelimTwoday" target="_blank" rel="noreferrer">GitHub</a>
		</nav>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--color-border);
		margin-top: 4rem;
		padding-block: 2rem;
		color: var(--color-text-muted);
		font-size: 0.9rem;
	}

	.site-footer__inner {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 2rem;
		align-items: center;
		justify-content: space-between;
	}

	.site-footer__nav {
		display: flex;
		flex-wrap: wrap;
		gap: 1.1rem;
	}

	.site-footer__nav a {
		color: var(--color-text-muted);
		text-decoration: none;
	}

	.site-footer__nav a:hover {
		color: var(--color-primary);
	}
</style>
