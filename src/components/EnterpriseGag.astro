---
import { ENTERPRISE_GAG_MONTHS, ENTERPRISE_GAG_PRICE } from '../scripts/enterprise-gag';
import { formatSwedishNumber } from '../lib/pert/format';
---

<dialog
	id="enterprise-gag-dialog"
	class="enterprise-gag"
	aria-labelledby="enterprise-gag-title"
	aria-describedby="enterprise-gag-disclaimer"
>
	<div class="enterprise-gag__content">
		<header class="enterprise-gag__header">
			<span class="enterprise-gag__badge">Enterprise Procurement Experience™</span>
			<h2 id="enterprise-gag-title">PERT Pro <span>Enterprise</span></h2>
		</header>

		<section id="enterprise-gag-offer">
			<p class="enterprise-gag__lead">Samma estimat. Betydligt mer inköpsavdelning.</p>
			<div class="enterprise-gag__price">
				<strong>{formatSwedishNumber(ENTERPRISE_GAG_PRICE, 0)} kr</strong>
				<span>per användare och månad. Självförtroende ingår.</span>
			</div>
			<ul class="enterprise-gag__features">
				<li>Egna deluppgifter för varje användare – lika vikt, oavsett antal rader.</li>
				<li>Gruppestimat, avvikelser och osäkerhetsintervall som ser bra ut på möten.</li>
				<li>Importera PERT-länkar och återanvänd deluppgifter utan extra konsulttimmar.</li>
				<li>Kopiera länk, PNG eller båda. Redo för din nästa styrgrupp.</li>
			</ul>
			<p class="enterprise-gag__terms">
				12 månader betalas i förskott. Inget öppet köp. Ingen ångerrätt.
				Uppsägning endast via rekommenderad flaskpost till vår Customer Success-kajak.
			</p>
			<div class="enterprise-gag__buttons">
				<button type="button" class="button button-primary" data-enterprise-buy>
					Köp nu – låt ekonomi lösa resten
				</button>
				<button type="button" class="button button-secondary" data-enterprise-buy>
					Betala direkt – jag gillar bindningstid
				</button>
			</div>
		</section>

		<section id="enterprise-gag-receipt" class="enterprise-gag__receipt" tabindex="-1" aria-labelledby="enterprise-gag-receipt-title" hidden>
			<div class="enterprise-gag__money" aria-hidden="true">
				{Array.from({ length: 6 }, (_, index) => (
					<span style={`--bill-index: ${index}`}>kr</span>
				))}
				<svg viewBox="0 0 80 64" width="80" height="64" fill="none" stroke="currentColor" stroke-width="3">
					<path d="M12 22h53a5 5 0 0 1 5 5v26a5 5 0 0 1-5 5H15a7 7 0 0 1-7-7V17a7 7 0 0 1 7-7h45v12" />
					<path d="M70 34H54a6 6 0 0 0 0 12h16" />
					<circle cx="55" cy="40" r="1" />
				</svg>
			</div>
			<h3 id="enterprise-gag-receipt-title">Tolv månader. Ett klick. Inga frågor.</h3>
			<div class="enterprise-gag__amount" aria-hidden="true">
				<span>−</span><span id="enterprise-gag-amount">0 kr</span>
			</div>
			<p class="enterprise-gag__calculation">
				1 användare × {ENTERPRISE_GAG_MONTHS} månader × {formatSwedishNumber(ENTERPRISE_GAG_PRICE, 0)} kr
			</p>
			<div class="enterprise-gag__months" aria-hidden="true">
				{Array.from({ length: ENTERPRISE_GAG_MONTHS }, (_, index) => (
					<span data-enterprise-month={index + 1}>M{index + 1}</span>
				))}
			</div>
			<p id="enterprise-gag-progress" class="enterprise-gag__progress"></p>
			<p id="enterprise-gag-message" class="enterprise-gag__message" role="status" aria-live="polite"></p>
			<button id="enterprise-gag-continue" type="button" class="button button-primary" disabled>
				Till kalkylatorn!
			</button>
		</section>

		<p id="enterprise-gag-disclaimer" class="enterprise-gag__disclaimer">
			Verktyget är gratis, inget konto debiteras på riktigt.
		</p>
		<p id="enterprise-gag-storage-status" class="enterprise-gag__storage-status" role="status" aria-live="polite"></p>
	</div>
</dialog>

<style>
	.enterprise-gag {
		width: min(calc(100% - 2rem), 34rem);
		max-height: calc(100dvh - 2rem);
		padding: 0;
		overflow-y: auto;
		color: var(--color-text);
		background: var(--color-bg-elevated);
		border: 1px solid var(--color-primary);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-elevated);
	}

	.enterprise-gag::backdrop {
		background: rgb(0 0 0 / 0.75);
		backdrop-filter: blur(5px);
	}

	.enterprise-gag__content {
		padding: clamp(1.25rem, 4vw, 2rem);
		background: radial-gradient(ellipse at top right, var(--color-primary-muted), transparent 65%);
	}

	.enterprise-gag__badge {
		font-size: 0.65rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-primary);
	}

	.enterprise-gag h2 {
		margin: 0.35rem 0 0;
		font-size: clamp(1.5rem, 5vw, 2rem);
		line-height: 1.2;
	}

	.enterprise-gag h2 span {
		font-weight: 500;
		color: var(--color-primary);
	}

	.enterprise-gag__lead {
		margin: 0.75rem 0 1rem;
		color: var(--color-text-muted);
	}

	.enterprise-gag__price {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: 1rem;
		background: var(--color-primary-muted);
		border: 1px solid var(--color-border-strong);
		border-radius: var(--radius-md);
	}

	.enterprise-gag__price strong {
		font-size: 2.25rem;
		line-height: 1.1;
	}

	.enterprise-gag__price span {
		font-size: 0.8rem;
		color: var(--color-text-muted);
	}

	.enterprise-gag__features {
		display: grid;
		gap: 0.6rem;
		padding-left: 1.25rem;
		margin: 1.25rem 0;
		font-size: 0.88rem;
	}

	.enterprise-gag__features li::marker {
		color: var(--color-primary);
	}

	.enterprise-gag__terms {
		padding: 0.75rem;
		border-left: 3px solid var(--color-primary);
		background: var(--color-bg-elevated-2);
		font-size: 0.8rem;
		color: var(--color-text-muted);
	}

	.enterprise-gag__buttons {
		display: grid;
		gap: 0.65rem;
		margin-top: 1.25rem;
	}

	.enterprise-gag .button {
		width: 100%;
		white-space: normal;
	}

	.enterprise-gag__receipt {
		text-align: center;
		padding-top: 1.25rem;
	}

	.enterprise-gag__receipt h3 {
		margin: 0.75rem 0;
		font-size: 1.25rem;
	}

	.enterprise-gag__money {
		position: relative;
		width: 5rem;
		margin: 0 auto;
		color: var(--color-primary);
	}

	.enterprise-gag__money span {
		position: absolute;
		top: 50%;
		left: 50%;
		padding: 0.1rem 0.4rem;
		background: var(--color-primary);
		color: var(--color-primary-contrast);
		border-radius: 4px;
		font-size: 0.8rem;
		font-weight: 800;
		opacity: 0;
		pointer-events: none;
	}

	.enterprise-gag[data-phase='charging'] .enterprise-gag__money span {
		animation: enterprise-bill 1s calc(var(--bill-index) * 0.13s) infinite;
	}

	.enterprise-gag__receipt-label,
	.enterprise-gag__calculation,
	.enterprise-gag__progress {
		margin: 0.5rem 0;
		font-size: 0.8rem;
		color: var(--color-text-muted);
	}

	.enterprise-gag__amount {
		display: flex;
		justify-content: center;
		gap: 0.25rem;
		margin: 0.75rem 0;
		font-size: clamp(1.75rem, 6vw, 2.5rem);
		font-weight: 900;
		line-height: 1.2;
		color: var(--color-danger);
		font-variant-numeric: tabular-nums;
	}

	.enterprise-gag__months {
		display: grid;
		grid-template-columns: repeat(6, 1fr);
		gap: 0.4rem;
		margin-top: 1rem;
	}

	.enterprise-gag__months span {
		padding: 0.4rem 0;
		border: 1px solid var(--color-border-strong);
		border-radius: 8px;
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--color-text-muted);
		transition: background-color 150ms ease, color 150ms ease;
	}

	.enterprise-gag__months [data-charged='true'] {
		background: var(--color-primary-muted);
		border-color: var(--color-primary);
		color: var(--color-primary);
		animation: enterprise-stamp 250ms ease-out;
	}

	.enterprise-gag__message {
		min-height: 3.5em;
		margin: 1rem 0;
		font-size: 0.9rem;
	}

	.enterprise-gag__disclaimer {
		margin: 1.25rem 0 0;
		padding-top: 0.75rem;
		border-top: 1px solid var(--color-border);
		font-size: 0.73rem;
		line-height: 1.4;
		color: var(--color-text-muted);
	}

	.enterprise-gag__storage-status {
		font-size: 0.8rem;
		color: var(--color-danger);
	}

	.enterprise-gag__storage-status:empty {
		display: none;
	}

	.enterprise-gag [hidden] {
		display: none;
	}

	@keyframes enterprise-bill {
		0% { opacity: 0; transform: translate(-50%, -50%) rotate(-10deg); }
		20% { opacity: 1; }
		100% { opacity: 0; transform: translate(calc((var(--bill-index) - 2.5) * 2rem), -6rem) rotate(25deg); }
	}

	@keyframes enterprise-stamp {
		0% { transform: scale(1.15) rotate(-5deg); }
		100% { transform: scale(1) rotate(0); }
	}

	@media (prefers-reduced-motion: reduce) {
		.enterprise-gag *,
		.enterprise-gag *::before,
		.enterprise-gag *::after {
			animation: none !important;
			transition: none !important;
		}
	}
</style>
