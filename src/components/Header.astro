---

<header class="site-header">
	<div class="container site-header__inner">
		<a class="site-header__brand" href="/">
			<span class="site-header__mark" aria-hidden="true">🐦</span>
			<span>SelimTwoday</span>
		</a>
		<nav aria-label="Huvudnavigation" class="site-header__nav">
			<a href="/">Hem</a>
			<a href="/verktyg/pert/">PERT-kalkylator</a>
			<a href="/verktyg/kodfilosofi/">Kodfilosofi</a>
		</nav>
	</div>
</header>

<style>
	.site-header {
		border-bottom: 1px solid var(--color-border);
		background: var(--color-bg-elevated);
	}

	.site-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		padding-block: 1rem;
	}

	.site-header__brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		color: var(--color-text);
		font-weight: 800;
		text-decoration: none;
		font-size: 1.05rem;
	}

	.site-header__mark {
		display: inline-grid;
		place-items: center;
		width: 2.1rem;
		height: 2.1rem;
		border-radius: 8px;
		background: var(--color-bg-elevated-2);
		color: var(--color-primary-contrast);
		font-size: 1.2rem;
		font-weight: 900;
	}

	.site-header__nav {
		display: flex;
		gap: 1.25rem;
		flex-wrap: wrap;
	}

	.site-header__nav a {
		color: var(--color-text-muted);
		text-decoration: none;
		font-weight: 600;
		font-size: 0.95rem;
		padding-block: 0.25rem;
	}

	.site-header__nav a:hover {
		color: var(--color-text);
	}
</style>
