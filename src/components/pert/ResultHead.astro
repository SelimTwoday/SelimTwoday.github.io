---
export interface Props {
	label: string;
	tail: 'sd' | 'likely';
}

const { label, tail } = Astro.props;
---

<div class="pert-head">
	<span class="pert-head__label">{label}</span>
	<p class="pert-head__value pert-num" aria-live="polite"><span data-out="headline">–</span><span class="pert-head__unit">h</span></p>
	<p class="pert-head__sub">
		≈ <span class="pert-num" data-out="days">–</span> arbetsdagar à
		<input class="pert-inline pert-num" data-hpd inputmode="decimal" autocomplete="off" maxlength="6" aria-label="Timmar per arbetsdag" />
		h
		{tail === 'sd' && <span> · ± <span class="pert-num" data-out="sd">–</span> h</span>}
		{tail === 'likely' && <span> · sannolikt <span class="pert-num" data-out="likely">–</span> h</span>}
	</p>
	<p class="pert-prelim" data-out="prelim" hidden></p>
</div>
